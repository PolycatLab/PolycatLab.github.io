@article{RN1537,
   author = {Thevenon, A. and Romain, C. and Bennington, M. S. and White, A. J. and Davidson, H. J. and Brooker, S. and Williams, C. K.},
   title = {Dizinc Lactide Polymerization Catalysts: Hyperactivity by Control of Ligand Conformation and Metallic Cooperativity},
