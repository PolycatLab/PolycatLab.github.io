   title = {Workflows Allowing Creation of Journal Article Supporting Information and Findable, Accessible, Interoperable, and Reusable (FAIR)-Enabled Publication of Spectroscopic Data},
   journal = {ACS Omega},
   volume = {4},
   number = {2},
   pages = {3280-3286},
   note = {Barba, Agustin
Dominguez, Santiago
Cobas, Carlos
