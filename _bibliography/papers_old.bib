@article{RN1516,
   author = {Dagorne, S. and Bellemin-Laponnaz, S. and Romain, C.},
   title = {Neutral and Cationic N-Heterocyclic Carbene Zirconium and Hafnium Benzyl Complexes: Highly Regioselective Oligomerization of 1-Hexene with a Preference for Trimer Formation},
   journal = {Organometallics},
   volume = {32},
